<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Explore all creations in VibeGallery. Filter, search, and browse the full catalog of premium designs.">
    <title>Creations — VibeGallery Design Museum</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" href="assets/images/favicon.jpg" type="image/jpeg">
    <link rel="stylesheet" href="style.css">
</head>
<body class="gallery-page">
    <!-- Ambient Background Orbs -->
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <!-- Gallery Layout Container -->
    <div class="app-layout">
        <!-- Sidebar Navigation (Left) -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-workspace-header">
                <a href="index.html" class="workspace-info" style="text-decoration: none; color: inherit;">
                    <img src="assets/images/favicon.jpg" alt="VibeGallery Logo" style="width: 18px; height: 18px; border-radius: 4px; object-fit: cover; flex-shrink: 0; border: 1px solid rgba(67, 52, 34, 0.1);">
                    <span class="workspace-name">VibeGallery Workspace</span>
                    <svg class="workspace-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </a>
                <button class="sidebar-collapse-btn" id="sidebar-collapse-btn" title="Collapse sidebar">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="11 17 6 12 11 7"></polyline>
                        <polyline points="18 17 13 12 18 7"></polyline>
                    </svg>
                </button>
            </div>

            <!-- Quick Links -->
            <div class="sidebar-quick-links">
                <a href="index.html" class="sidebar-item back-museum-btn">
                    <span class="item-icon">🏛️</span>
                    <span class="item-text">Back to Museum</span>
                </a>
            </div>

            <!-- Search (Notion style) -->
            <div class="sidebar-search-container">
                <div class="search-wrapper">
                    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="search-input" id="search-input" placeholder="Search catalog...">
                    <span class="search-shortcut">/</span>
                </div>
            </div>

            <!-- Collapsible Sections -->
            <div class="sidebar-scrollable-content">
                <!-- Categories Collapsible Section -->
                <div class="sidebar-section" id="section-categories">
                    <div class="sidebar-section-header" id="header-categories">
                        <svg class="disclosure-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                        <span class="sidebar-label">Categories</span>
                    </div>
                    <div class="sidebar-section-content active" id="content-categories">
                        <button class="sidebar-item active vertical-tab" data-filter="all">
                            <span class="item-icon">📦</span>
                            <span class="item-text">All Designs</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="dashboard">
                            <span class="item-icon">📊</span>
                            <span class="item-text">Dashboards</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="landing">
                            <span class="item-icon">🎨</span>
                            <span class="item-text">Landing Pages</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="ecommerce">
                            <span class="item-icon">🛍️</span>
                            <span class="item-text">E-Commerce</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="app">
                            <span class="item-icon">💬</span>
                            <span class="item-text">Web Apps</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="hero">
                            <span class="item-icon">🖼️</span>
                            <span class="item-text">Hero Sections</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="about">
                            <span class="item-icon">ℹ️</span>
                            <span class="item-text">About Sections</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="footer">
                            <span class="item-icon">👣</span>
                            <span class="item-text">Footer Sections</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="button">
                            <span class="item-icon">🔘</span>
                            <span class="item-text">Buttons & Cards</span>
                        </button>
                        <button class="sidebar-item vertical-tab" data-filter="sidebar">
                            <span class="item-icon">🎛️</span>
                            <span class="item-text">Sidebar Modes</span>
                        </button>
                    </div>
                </div>

                <!-- Languages Collapsible Section -->
                <div class="sidebar-section" id="section-languages">
                    <div class="sidebar-section-header" id="header-languages">
                        <svg class="disclosure-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                        <span class="sidebar-label">Languages</span>
                    </div>
                    <div class="sidebar-section-content active" id="content-languages">
                        <button class="sidebar-item active lang-btn" data-lang="all" title="All Languages">
                            <span class="item-icon">🌐</span>
                            <span class="item-text">All Languages</span>
                        </button>
                        <button class="sidebar-item lang-btn" data-lang="en" title="English designs">
                            <span class="item-icon">🇬🇧</span>
                            <span class="item-text">English (EN)</span>
                        </button>
                        <button class="sidebar-item lang-btn" data-lang="ar" title="Arabic designs">
                            <span class="item-icon">🇸🇦</span>
                            <span class="item-text">Arabic (AR)</span>
                        </button>
                        <button class="sidebar-item lang-btn" data-lang="zh" title="Chinese designs">
                            <span class="item-icon">🇨🇳</span>
                            <span class="item-text">Chinese (ZH)</span>
                        </button>
                        <button class="sidebar-item lang-btn" data-lang="ja" title="Japanese designs">
                            <span class="item-icon">🇯🇵</span>
                            <span class="item-text">Japanese (JA)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Stats in Sidebar (Bottom-fixed style) -->
            <div class="sidebar-stats">
                <div class="stats-header">
                    <span class="stats-label">Museum Stats</span>
                </div>
                <div class="stats-grid">
                    <div class="stat-pill">
                        <span class="stat-count" id="sidebar-stat-items">34</span>
                        <span class="stat-name">items</span>
                    </div>
                    <div class="stat-pill">
                        <span class="stat-count" id="sidebar-stat-langs">4</span>
                        <span class="stat-name">langs</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Sidebar Floating Expand Handle -->
        <button class="sidebar-expand-btn" id="sidebar-expand-btn" title="Expand sidebar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="13 17 18 12 13 7"></polyline>
                <polyline points="6 17 11 12 6 7"></polyline>
            </svg>
        </button>

        <!-- Sidebar Mobile Overlay Backdrop -->
        <div class="sidebar-overlay" id="sidebar-overlay"></div>

        <!-- Main Gallery Canvas (Right) -->
        <main class="main-content">
            <header class="content-header">
                <div class="header-left">
                    <button class="header-sidebar-toggle" id="header-sidebar-toggle" title="Show sidebar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="9" y1="3" x2="9" y2="21"></line>
                        </svg>
                    </button>
                    <div class="header-title-wrapper">
                        <h1 class="page-title">Creations Catalog</h1>
                        <p class="page-description">Browse and discover all design works within the museum.</p>
                    </div>
                </div>
                <div class="header-right">
                    <span class="result-count" id="result-count">Showing 6 designs</span>
                    <div class="view-toggles">
                        <button class="view-btn active" data-view="grid" id="view-grid" aria-label="Grid view">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                                <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                            </svg>
                        </button>
                        <button class="view-btn" data-view="list" id="view-list" aria-label="List view">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Card Grid -->
            <div class="gallery-grid" id="gallery-grid">
                <!-- Injected dynamically by JS -->
            </div>

            <!-- Load More & Pagination Controls -->
            <div class="gallery-controls-container">
                <button class="load-more-btn" id="load-more-btn">Load More</button>
                <div class="pagination-container" id="pagination-container"></div>
            </div>

            <!-- Empty State -->
            <div class="empty-state hidden" id="empty-state">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="M21 21l-4.35-4.35"/>
                    <path d="M8 11h6"/>
                </svg>
                <h3>No creations found</h3>
                <p>Try clearing filters or search terms.</p>
            </div>
        </main>
    </div>

    <!-- Lightbox Modal -->
    <div class="lightbox-overlay hidden" id="lightbox-overlay">
        <div class="lightbox" id="lightbox">
            <button class="lightbox-close" id="lightbox-close" aria-label="Close lightbox">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
            </button>
            <div class="lightbox-image-wrap">
                <img src="" alt="" class="lightbox-image" id="lightbox-image">
            </div>
            <div class="lightbox-info">
                <h3 class="lightbox-title" id="lightbox-title"></h3>
                <p class="lightbox-desc" id="lightbox-desc"></p>
                <div class="lightbox-meta">
                    <span class="lightbox-category" id="lightbox-category"></span>
                    <span class="lightbox-lang" id="lightbox-lang"></span>
                    <span class="lightbox-tags" id="lightbox-tags"></span>
                </div>
                <a href="#" target="_blank" rel="noopener noreferrer" class="lightbox-open-btn" id="lightbox-open-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                    Open in New Tab
                </a>
            </div>
        </div>
    </div>

    <script src="data.js"></script>
    <script src="gallery.js"></script>
</body>
</html>
