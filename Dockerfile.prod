# ── Stage 1: Build ──
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependency files
COPY package*.json ./

# Install all packages (development + production) to enable compilation
RUN npm ci

# Copy application source files
COPY . .

# Compile optimized bundle
RUN npm run build

# ── Stage 2: Production Server ──
FROM nginxinc/nginx-unprivileged:alpine

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy routing configurations
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose non-privileged HTTP port
EXPOSE 8080

# Health check setup for verification
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:8080/ || exit 1

# Start server (run parameter is defined in base image)
CMD ["nginx", "-g", "daemon off;"]
